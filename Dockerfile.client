# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the subscriber client
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo \
    -o subscriber_client ./examples/subscriber_client.go

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/subscriber_client .

# Run the client
CMD ["./subscriber_client"]

